              <zone h='8193' id='123' param='horz' type-v2='layout-flow' w='100000' x='0' y='91807'>
                <zone forceUpdate='true' h='8193' id='124' type-v2='text' w='50714' x='0' y='91807'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#4e79a7' fontname='Noto Sans Georgian Bold' fontsize='24'>THANK YOU FOR READING</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#4e79a7' fontname='Noto Sans Georgian Bold' fontsize='24'> How the World Plays 1971 — 2024</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontname='Noto Sans Georgian Bold' fontsize='20'>PROJECT AT A GLANCE</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Noto Sans Armenian' fontsize='16'>64,016 games analyzed </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Noto Sans Armenian' fontsize='16'>1971–2024 </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Noto Sans Armenian' fontsize='16'>5 analytical chapters </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Noto Sans Armenian' fontsize='16'>SQL-first workflow </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Noto Sans Armenian' fontsize='16'>Built with Tableau &amp; Figma</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Noto Sans Armenian' fontsize='20'>Methodology</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Noto Sans Armenian' fontsize='16'>Data preparation and aggregation were performed in PostgreSQL. Visualizations were designed in Figma and developed in Tableau Public using chapter-specific datasets.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#9d7660' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='4' />
                    <format attr='margin' value='11' />
                    <format attr='padding' value='11' />
                    <format attr='background-color' value='#f5eddc' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='8193' id='125' type-v2='text' w='49286' x='50714' y='91807'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontname='Noto Sans Georgian Bold' fontsize='24'>END OF ANALYSIS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#606b76' fontname='Noto Sans Georgian Bold' fontsize='18'>Video games evolved through changing technologies,</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#606b76' fontname='Noto Sans Georgian Bold' fontsize='18'>shifting player preferences, and fierce competition between platforms.</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#606b76' fontname='Noto Sans Georgian Bold' fontsize='18'>Yet one thing remained constant:</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Noto Sans Georgian Bold' fontsize='20'>Every generation found its own way to play.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontname='Noto Sans Georgian Bold' fontsize='14'>Data Source: VGChartz (1971–2024)</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontname='Noto Sans Georgian Bold' fontsize='14'>Designed &amp; Developed by</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontname='Noto Sans Georgian Bold' fontsize='14'>Ezequiel Gonzalez</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontname='Noto Sans Georgian Bold' fontsize='14'>SQL • PostgreSQL • Tableau • Figma</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#9d7660' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='4' />
                    <format attr='margin' value='11' />
                    <format attr='padding' value='11' />
                    <format attr='background-color' value='#f5eddc' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
