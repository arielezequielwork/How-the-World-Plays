                    <run bold='true' fontcolor='#f28e2b' fontname='Noto Sans Georgian Bold' fontsize='20'>PROJECT OVERVIEW               </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Noto Sans Georgian Bold' fontsize='18'>1971–2024                    </run>
                    <run bold='true' fontcolor='#000000' fontname='Noto Sans Georgian Bold' fontsize='14'>64,016 </run>
                    <run fontalignment='1'>Æ&#10;</run>
