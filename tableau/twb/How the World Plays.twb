              <zone forceUpdate='true' h='2594' id='103' type-v2='text' w='100000' x='0' y='88459'>
                <formatted-text>
                  <run bold='true' fontcolor='#4e79a7' fontname='Tableau Bold' fontsize='16'>KEY INSIGHT</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>Strong reviews increase the chances of commercial success,</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>but they are far from the only factor.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>Marketing, platform availability, franchise recognition,</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>and timing often played just as important a role in creating blockbuster titles.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
